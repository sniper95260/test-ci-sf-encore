{% extends 'layouts/base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">

    <h1>SWAT - Symfony Webpack Automation Toolkit</h1>

    {% if build_info.environment is defined and build_info.environment == 'preprod' %}
        <div class="app-build-info">
            {{ build_version_label }}
            {% if build_info.build_date %}
                <span>• {{ build_info.build_date }}</span>
            {% endif %}
        </div>
    {% elseif build_version_label %}
        <div class="app-build-info">
            {{ build_version_label }}
        </div>
    {% else %}
        <div class="app-build-info">
            No build information available.
        </div>
    {% endif %}

</div>
{% endblock %}
