{% extends 'layouts/base.html.twig' %}

{% block title %}SWAT - Setup Guide{% endblock %}

{% block body %}

    <main>

        <div class="docs-layout">

            <aside class="docs-toc">
                <div class="docs-toc_inner">
                    <div class="docs-toc_title">On this page</div>

                    <a href="#requirements" class="docs-toc_link">Requirements</a>
                    <a href="#install-swat" class="docs-toc_link">Install SWAT</a>
                    <a href="#start-your-app" class="docs-toc_link">Start your app</a>
                    <a href="#verify-your-setup" class="docs-toc_link">Verify your setup</a>
                    <a href="#github-secrets" class="docs-toc_link">GitHub secrets</a>
                    <a href="#github-branch-rules" class="docs-toc_link">Branch rules</a>
                    <a href="#server-environment" class="docs-toc_link">Server environment</a>
                    <a href="#next-steps" class="docs-toc_link">Next steps</a>
                </div>
            </aside>

            <div class="setup-guide-page">

                <div class="hero">
                    <h1 class="hero_title">Setup Guide</h1>
                    <p class="hero_subtitle">
                        Install and configure SWAT in just a few minutes.
                    </p>
                </div>

                <div class="section-anchor" id="requirements"></div>
                <div class="section-title">
                    <span class="section-title_text">Requirements</span>
                </div>

                <div class="requirements-grid">

                    <article class="requirements-card">
                        <div class="requirements-card_icon">🐘</div>
                        <div class="requirements-card_title">PHP 8.2+</div>
                        <div class="requirements-card_description">
                            Required
                        </div>
                    </article>

                    <article class="requirements-card">
                        <div class="requirements-card_icon">📦</div>
                        <div class="requirements-card_title">Composer</div>
                        <div class="requirements-card_description">
                            Required
                        </div>
                    </article>

                    <article class="requirements-card">
                        <div class="requirements-card_icon">🧩</div>
                        <div class="requirements-card_title">npm or yarn</div>
                        <div class="requirements-card_description">
                            Required
                        </div>
                    </article>

                    <article class="requirements-card">
                        <div class="requirements-card_icon">⚡</div>
                        <div class="requirements-card_title">Symfony CLI</div>
                        <div class="requirements-card_description">
                            Optional but recommended
                        </div>
                    </article>

                </div>

                <div class="section-anchor" id="install-swat"></div>
                <div class="section-title">
                    <span class="section-title_text">Install SWAT</span>
                </div>

                <div class="terminal-block">

                    <div class="terminal-block_terminal">

                        <div class="terminal-block_line">
                            <span class="terminal-block_text terminal-block_text--comment"># Clone the repository</span>
                        </div>

                        <div class="terminal-block_line">
                            <span class="terminal-block_prompt">></span>
                            <span class="terminal-block_text">git clone https://github.com/your-repo/swat.git</span>
                        </div>

                        <div class="terminal-block_line">
                            <span class="terminal-block_text"></span>
                        </div>

                        <div class="terminal-block_line">
                            <span class="terminal-block_text terminal-block_text--comment"># Enter the project directory</span>
                        </div>

                        <div class="terminal-block_line">
                            <span class="terminal-block_prompt">></span>
                            <span class="terminal-block_text">cd swat</span>
                        </div>

                        <div class="terminal-block_line">
                            <span class="terminal-block_text"></span>
                        </div>

                        <div class="terminal-block_line">
                            <span class="terminal-block_text terminal-block_text--comment"># Install PHP dependencies</span>
                        </div>

                        <div class="terminal-block_line">
                            <span class="terminal-block_prompt">></span>
                            <span class="terminal-block_text">composer install</span>
                        </div>

                        <div class="terminal-block_line">
                            <span class="terminal-block_text"></span>
                        </div>

                        <div class="terminal-block_line">
                            <span class="terminal-block_text terminal-block_text--comment"># Install frontend dependencies</span>
                        </div>

                        <div class="terminal-block_line">
                            <span class="terminal-block_prompt">></span>
                            <span class="terminal-block_text">npm install</span>
                        </div>

                        <div class="terminal-block_line">
                            <span class="terminal-block_text"></span>
                        </div>

                        <div class="terminal-block_line">
                            <span class="terminal-block_text terminal-block_text--comment"># Build frontend assets</span>
                        </div>

                        <div class="terminal-block_line">
                            <span class="terminal-block_prompt">></span>
                            <span class="terminal-block_text">npm run dev</span>
                        </div>

                    </div>

                </div>

                <div class="section-anchor" id="start-your-app"></div>
                <div class="section-title">
                    <span class="section-title_text">Start your app</span>
                </div>

                <div class="terminal-block">

                    <div class="terminal-block_terminal">

                        <div class="terminal-block_line">
                            <span class="terminal-block_text terminal-block_text--comment"># With Symfony CLI (recommended)</span>
                        </div>

                        <div class="terminal-block_line">
                            <span class="terminal-block_prompt">></span>
                            <span class="terminal-block_text">symfony serve</span>
                        </div>

                        <div class="terminal-block_line">
                            <span class="terminal-block_text"></span>
                        </div>

                        <div class="terminal-block_line">
                            <span class="terminal-block_text terminal-block_text--comment"># Without Symfony CLI</span>
                        </div>

                        <div class="terminal-block_line">
                            <span class="terminal-block_prompt">></span>
                            <span class="terminal-block_text">php -S localhost:8000 -t public</span>
                        </div>

                    </div>

                </div>

                <div class="section-anchor" id="verify-your-setup"></div>
                <div class="section-title">
                    <span class="section-title_text">Verify your setup</span>
                </div>

                <div class="verify-setup">

                    <p class="verify-setup_text">
                        Open your application at <a href="http://localhost:8000" target="_blank" rel="noopener noreferrer">http://localhost:8000</a> to verify that your environment is running correctly.
                    </p>

                    <div class="verify-setup_actions">

                        <a href="http://localhost:8000" target="_blank" rel="noopener noreferrer" class="verify-setup_button">
                            Open local SWAT home page
                        </a>

                    </div>

                </div>

                <div class="section-anchor" id="github-secrets"></div>
                <div class="section-title">
                    <span class="section-title_text">Add your GitHub secrets</span>
                </div>

                <div class="github-secrets">

                    <p class="github-secrets_text">
                        SWAT uses GitHub Actions to deploy your application automatically.
                        Add the following secrets in your repository settings.
                    </p>

                    <div class="github-secrets_path">
                        Settings → Secrets and variables → Actions
                    </div>

                    <div class="github-secrets_group">

                        <h2 class="github-secrets_title">Preproduction</h2>

                        <div class="github-secrets_table-wrapper">
                            <table class="github-secrets_table">
                                <thead>
                                    <tr>
                                        <th>Secret</th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>PREPROD_HOST</td>
                                        <td>Hostname or IP address of the preproduction server.</td>
                                    </tr>
                                    <tr>
                                        <td>PREPROD_KNOWN_HOSTS</td>
                                        <td>Known hosts fingerprint used to validate the SSH connection.</td>
                                    </tr>
                                    <tr>
                                        <td>PREPROD_PATH</td>
                                        <td>Target directory where the application is deployed on the server.</td>
                                    </tr>
                                    <tr>
                                        <td>PREPROD_PORT</td>
                                        <td>SSH port used to connect to the preproduction server.</td>
                                    </tr>
                                    <tr>
                                        <td>PREPROD_SSH_KEY</td>
                                        <td>Private SSH key used for the deployment.</td>
                                    </tr>
                                    <tr>
                                        <td>PREPROD_USER</td>
                                        <td>SSH user used to connect to the preproduction server.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>

                    <div class="github-secrets_group">

                        <h2 class="github-secrets_title">Production</h2>

                        <div class="github-secrets_table-wrapper">
                            <table class="github-secrets_table">
                                <thead>
                                    <tr>
                                        <th>Secret</th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>PROD_HOST</td>
                                        <td>Hostname or IP address of the production server.</td>
                                    </tr>
                                    <tr>
                                        <td>PROD_KNOWN_HOSTS</td>
                                        <td>Known hosts fingerprint used to validate the SSH connection.</td>
                                    </tr>
                                    <tr>
                                        <td>PROD_PATH</td>
                                        <td>Target directory where the application is deployed on the server.</td>
                                    </tr>
                                    <tr>
                                        <td>PROD_PORT</td>
                                        <td>SSH port used to connect to the production server.</td>
                                    </tr>
                                    <tr>
                                        <td>PROD_SSH_KEY</td>
                                        <td>Private SSH key used for the deployment.</td>
                                    </tr>
                                    <tr>
                                        <td>PROD_USER</td>
                                        <td>SSH user used to connect to the production server.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>

                </div>

                <div class="section-anchor" id="github-branch-rules"></div>
                <div class="section-title">
                    <span class="section-title_text">Configure your GitHub branch rules</span>
                </div>

                <div class="github-branch-rules">

                    <p class="github-branch-rules_text">
                        To keep your deployment workflow safe and consistent, configure branch protection rules on both
                        <strong>dev</strong> and <strong>master</strong>.
                    </p>

                    <p class="github-branch-rules_text">
                        In your repository, go to <strong>Settings → Branches</strong>, then create a rule for each branch.
                    </p>

                    <div class="github-branch-rules_box">

                        <h2 class="github-branch-rules_title">Recommended rules</h2>

                        <ul class="github-branch-rules_list">
                            <li>Require a pull request before merging</li>
                            <li>Require status checks to pass before merging</li>
                            <li>Require branches to be up to date before merging</li>
                            <li>Require conversation resolution before merging</li>
                        </ul>

                    </div>

                    <div class="github-branch-rules_box">

                        <h2 class="github-branch-rules_title">Required status checks</h2>

                        <p class="github-branch-rules_note">
                            Select the <strong>build</strong> GitHub Actions check so that deployments can only happen after a successful pipeline.
                        </p>

                    </div>

                    <div class="github-branch-rules_box">

                        <h2 class="github-branch-rules_title">About pull request approvals</h2>

                        <p class="github-branch-rules_note">
                            If you work alone, requiring approvals is optional.
                            If several developers contribute to the project, enabling at least one approval before merging is strongly recommended.
                        </p>

                    </div>

                </div>

                <div class="section-anchor" id="server-environment"></div>
                <div class="section-title">
                    <span class="section-title_text">Configure your server environment variables</span>
                </div>

                <div class="server-config">

                    <p class="server-config_text">
                        SWAT uses environment variables to configure Symfony in production.
                        Make sure to set the correct values on each server for a smooth deployment experience.<br><br>

                        Each server must contain a <strong>.env.local</strong> file adapted to its environment.<br>
                        This file contains the environment variables used by Symfony in production.
                    </p>

                    <div class="terminal-block">

                        <div class="terminal-block_terminal">

                            <div class="terminal-block_line">
                                <span class="terminal-block_text terminal-block_text--comment"># Example .env.local configuration</span>
                            </div>

                            <div class="terminal-block_line">
                                <span class="terminal-block_text">APP_ENV=prod</span>
                            </div>

                            <div class="terminal-block_line">
                                <span class="terminal-block_text">APP_DEBUG=0</span>
                            </div>

                            <div class="terminal-block_line">
                                <span class="terminal-block_text">APP_SECRET=&lt;random secret&gt;</span>
                            </div>

                            <div class="terminal-block_line">
                                <span class="terminal-block_text"></span>
                            </div>

                            <div class="terminal-block_line">
                                <span class="terminal-block_text">DATABASE_URL=&lt;database url&gt;</span>
                            </div>

                            <div class="terminal-block_line">
                                <span class="terminal-block_text">DEFAULT_URI=&lt;default uri&gt;</span>
                            </div>

                            <div class="terminal-block_line">
                                <span class="terminal-block_text">TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR</span>
                            </div>

                        </div>

                    </div>

                    <div class="server-config_notes">

                        <p>
                            <strong>APP_SECRET</strong> must be a secure random string used by Symfony for cryptographic operations.
                        </p>

                        <p>
                            <strong>DATABASE_URL</strong> must contain the connection string for your production database.
                        </p>

                        <p>
                            <strong>DEFAULT_URI</strong> should match the public URL of your application.
                        </p>

                        <p>
                            <strong>TRUSTED_PROXIES</strong> is only required if your application runs behind a reverse proxy
                            (for example Nginx, Traefik or a load balancer).
                            If your server is directly exposed to the internet, this variable should not be defined.
                        </p>

                    </div>

                </div>

                <div class="section-anchor" id="next-steps"></div>
                <div class="section-title">
                    <span class="section-title_text">Next steps</span>
                </div>

                <div class="next-steps">

                    <p class="next-steps_text">
                        Your environment is now configured. Explore the documentation to understand
                        how <strong>SWAT</strong> automates deployments and how to adapt it to your workflow.
                    </p>

                    <div class="next-steps_actions">

                        <a href="{{ path('app_documentation') }}" class="next-steps_button">
                            Documentation
                        </a>

                        <a href="{{ path('app_faq') }}" class="next-steps_button">
                            FAQ
                        </a>

                    </div>

                </div>

            </div>

        </div>
        
    </main>

{% endblock %}