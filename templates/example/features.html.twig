{% extends 'layouts/base.html.twig' %}

{% block title %}SWAT - Features{% endblock %}

{% block body %}

    <main>

        <section class="features-page">

            <div class="hero">
                <h1 class="hero_title">Features</h1>
                <p class="hero_subtitle">
                    Explore the capabilities of SWAT and discover the tools that power a modern Symfony development workflow.
                </p>
            </div>

            <div class="section-title">
                <span class="section-title_text">Core features</span>
            </div>

            <div class="features-grid">

                <article class="features-grid_card">

                    <div class="features-grid_header">
                        <span class="features-grid_icon">🚀</span>
                        <h2 class="features-grid_title">Modern Symfony stack</h2>
                    </div>

                    <p class="features-grid_description">
                        Built on the latest Symfony version with a clean structure and production-ready defaults.
                    </p>

                </article>

                <article class="features-grid_card">

                    <div class="features-grid_header">
                        <span class="features-grid_icon">⚡</span>
                        <h2 class="features-grid_title">Lightning-fast frontend</h2>
                    </div>

                    <p class="features-grid_description">
                        Twig, Webpack Encore, TypeScript and SCSS. No heavy frameworks, just fast and maintainable code.
                    </p>

                </article>

                <article class="features-grid_card">

                    <div class="features-grid_header">
                        <span class="features-grid_icon">🔧</span>
                        <h2 class="features-grid_title">Automated CI/CD</h2>
                    </div>

                    <p class="features-grid_description">
                        GitHub Actions pipelines automatically build, test and deploy your application.
                    </p>

                </article>

                <article class="features-grid_card">

                    <div class="features-grid_header">
                        <span class="features-grid_icon">📦</span>
                        <h2 class="features-grid_title">Asset pipeline</h2>
                    </div>

                    <p class="features-grid_description">
                        Webpack Encore handles TypeScript, SCSS and asset optimization with minimal configuration.
                    </p>

                </article>

                <article class="features-grid_card">

                    <div class="features-grid_header">
                        <span class="features-grid_icon">🧪</span>
                        <h2 class="features-grid_title">Developer diagnostics</h2>
                    </div>

                    <p class="features-grid_description">
                        Built-in environment checks ensure Symfony, Twig, Encore and assets are running correctly.
                    </p>

                </article>

                <article class="features-grid_card">

                    <div class="features-grid_header">
                        <span class="features-grid_icon">🪶</span>
                        <h2 class="features-grid_title">Lightweight by design</h2>
                    </div>

                    <p class="features-grid_description">
                        Minimal dependencies and small bundles ensure fast performance and an efficient development experience.
                    </p>

                </article>

            </div>

            <div class="section-title">
                <span class="section-title_text">Why choose SWAT?</span>
            </div>

            <div class="why-swat">

                <p class="why-swat_intro">
                    SWAT is designed for developers who want a modern Symfony setup without the complexity
                    of a heavy frontend stack or an overengineered toolchain.
                </p>

                <div class="why-swat_points">

                    <div class="why-swat_point">
                        <h2 class="why-swat_title">Developer-first</h2>
                        <p class="why-swat_description">
                            Clean structure, fast feedback and predictable tooling.
                        </p>
                    </div>

                    <div class="why-swat_point">
                        <h2 class="why-swat_title">Performance-focused</h2>
                        <p class="why-swat_description">
                            Minimal assets, fast builds and excellent runtime performance.
                        </p>
                    </div>

                    <div class="why-swat_point">
                        <h2 class="why-swat_title">Production-ready</h2>
                        <p class="why-swat_description">
                            CI/CD, preview deployments and release workflows built in from day one.
                        </p>
                    </div>

                </div>

            </div>

            <div class="section-title">
                <span class="section-title_text">Ready to get started?</span>
            </div>

            <div class="next-steps">

                <p class="next-steps_text">
                    Start building with <strong>SWAT</strong> and explore the guides that help you move from setup to production.
                </p>

                <div class="next-steps_actions">
                    <a href="{{ path('app_setup_guide') }}" class="next-steps_button">
                        Setup Guide
                    </a>

                    <a href="{{ path('app_documentation') }}" class="next-steps_button">
                        Documentation
                    </a>

                    <a href="{{ path('app_faq') }}" class="next-steps_button">
                        FAQ
                    </a>
                </div>

            </div>

        </section>
        
    </main>

{% endblock %}