{% extends 'layouts/base.html.twig' %}

{% block title %}SWAT - Symfony Webpack Automation Toolkit{% endblock %}

{% block body %}

    <main>

        <section class="layout-medium">
            
            <div class="hero">
                <h1 class="hero_title">SWAT</h1>
                <p class="hero_subtitle">
                    Symfony Webpack Automation Toolkit<br><br>
                    A lightweight Symfony starter with built-in CI/CD, a modern frontend setup and a production-ready structure
                </p>
            </div>

            <div class="section_container">

                <div class="section-title">
                    <span class="section-title_text"></span>
                </div>

                <div class="section_content grid">

                    <div class="card col-4 md-col-6 sm-col-12">
                        <div class="card_content flex-column">
                            <span class="env_label">Symfony</span>
                            <span class="env_value">{{ constant('Symfony\\Component\\HttpKernel\\Kernel::VERSION') }}</span>
                        </div>
                    </div>

                    <div class="card col-4 md-col-6 sm-col-12">
                        <div class="card_content flex-column">
                            <span class="env_label">PHP</span>
                            <span class="env_value">{{ constant('PHP_VERSION') }}</span>
                        </div>
                    </div>

                    <div class="card col-4 md-col-6 sm-col-12">
                        <div class="card_content flex-column">
                            <span class="env_label">Environment</span>
                            <span class="env_value">{{ app.environment }}</span>
                        </div>
                    </div>

                </div>

            </div>

            <div class="section_container">

                <div class="section-title">
                    <span class="section-title_text">Stack status</span>
                </div>

                <div class="section_content grid">

                    <div class="card col-4 md-col-6 sm-col-12">
                        <div class="card_content flex-column">
                            <span class="env_label">Symfony</span>
                            <span class="status_state">✔ Running</span>
                        </div>
                    </div>

                    <div class="card col-4 md-col-6 sm-col-12">
                        <div class="card_content flex-column">
                            <span class="env_label">Twig</span>
                            <span class="status_state">✔ Rendering</span>
                        </div>
                    </div>

                    <div class="card col-4 md-col-6 sm-col-12">
                        <div class="card_content flex-column">
                            <span class="env_label">Encore</span>
                            <span class="status_state">✔ Assets loaded</span>
                        </div>
                    </div>

                    <div class="card col-4 md-col-6 sm-col-12">
                        <div class="card_content flex-column">
                            <span class="env_label">TypeScript</span>
                            <span class="status_state">✔ Compiled</span>
                        </div>
                    </div>

                    <div class="card col-4 md-col-6 sm-col-12">
                        <div class="card_content flex-column">
                            <span class="env_label">SCSS</span>
                            <span class="status_state">✔ Compiled</span>
                        </div>
                    </div>

                    <div class="card col-4 md-col-6 sm-col-12">
                        <div class="card_content flex-column">
                            <span class="env_label">Turbo</span>
                            <span class="status_state">✔ Loaded</span>
                        </div>
                    </div>

                </div>

            </div>

            <div class="section_container">

                <div class="section-title">
                    <span class="section-title_text">Typescript runtime</span>
                </div>

                <div class="section_content">
                    <div class="typescript-runtime_terminal" id="typescript-runtime-terminal"></div>
                </div>

            </div>

            <div class="section_container">
                <div class="section-title">
                    <span class="section-title_text">SCSS Check</span>
                </div>

                <div class="section_content">
                    <div class="scss-check">
                        <div class="scss-check_bar">
                            SCSS compiled successfully
                        </div>
                    </div>
                </div>
            </div>

            <div class="section_container">
                <div class="section-title">
                    <span class="section-title_text">What next?</span>
                </div>

                <div class="section_content justify-center">
                
                    <p class="next-steps_text">
                        Your environment is ready. Explore <strong>SWAT</strong>.
                    </p>

                    <div class="next-steps_actions">
                        <a href="{{ path('app_features') }}" class="next-steps_button">
                            Explore Features
                        </a>

                        <a href="{{ path('app_setup_guide') }}" class="next-steps_button">
                            Setup Guide
                        </a>

                        <a href="{{ path('app_documentation') }}" class="next-steps_button">
                            Documentation
                        </a>
                    </div>

                </div>
            </div>

        </section>
        
    </main>

{% endblock %}
