<div class="footer">
    <div class="footer_content">

        <p>SWAT - Symfony Webpack Automation Toolkit.</p>
        <p>&copy; {{ "now"|date("Y") }} Florian Depatin - Licensed under the MIT License.</p>

        {% if build_info.environment is defined and build_info.environment == 'preprod' %}
            <div class="app-build-info">
                {{ build_version_label }}
                {% if build_info.build_date %}
                    • {{ build_info.build_date }}
                {% endif %}
            </div>

        {% elseif build_version_label %}
            <div class="app-build-info">
                {{ build_version_label }}
            </div>

        {% else %}
            <div class="app-build-info">
                No build information available.
            </div>
        {% endif %}

    </div>
</div>