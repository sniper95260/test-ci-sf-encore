{% extends 'layouts/base.html.twig' %}

{% block title %}SWAT - Documentation - Customization{% endblock %}

{% block body %}

<main>

    <section class="layout-large">

        <div class="hero">
            <h1 class="hero_title">Customization</h1>
            <p class="hero_subtitle">
                Learn how to adapt SWAT to your specific needs and make it your own.
            </p>
        </div>

        <div class="section_container">
            
            <div class="section-title">
                <span class="section-title_text">Customization overview</span>
            </div>

            <div class="section_content">
                <p class="section_content_text">
                    SWAT is designed to be a flexible starting point for Symfony projects.
                    The provided structure, frontend stack and CI/CD workflows can be adapted
                    to match your own development and deployment workflow.

                    This section highlights the main areas where customization typically happens 
                    when starting a new project based on SWAT.
                </p>
            </div>

        </div>

        <div class="section_container">

            <div class="section-title">
                <span class="section-title_text">Removing example content</span>
            </div>

            <div class="section_content">
                <p class="section_content_text">
                    The project includes example pages, assets and tests used to demonstrate
                    the structure and verify that the stack works correctly. When starting
                    a real project, you may want to remove this content and keep only the
                    base structure.
                </p>

                <div class="terminal" style="max-width : 900px;">
                    <p>
                        <span class="terminal_comment"># These commands will remove example pages, assets and tests from the project</span><br>
                        <span class="terminal_comment"># Make sure to review the commands and adjust them if needed before running</span><br><br>

                        <span class="terminal_comment"># On windows, run this :</span><br>
                        <span class="terminal_command">.\scripts\cleanup\clean-example-files.ps1</span><br><br>

                        <span class="terminal_comment"># On Linux or MacOS, run this :</span><br>
                        <span class="terminal_command">./scripts/cleanup/clean-example-files.sh</span>
                    </p>
                </div>
            </div>

        </div>

        <div class="section_container">
            <div class="section-title">
                <span class="section-title_text">Adapting the CI/CD workflows</span>
            </div>

            <div class="section_content" style="max-width : 900px; margin: 0 auto;">
                <p class="section_content_text">
                    The provided GitHub Actions workflows can be adapted to fit your specific
                    deployment environment and workflow. You can modify the branches, triggers
                    or deployment steps as needed to match your hosting setup and deployment
                    process.
                </p>

                <table>
                    <thead>
                        <tr>
                            <th>Workflow</th>
                            <th>Purpose</th>
                            <th>Customization points</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Validation</td>
                            <td>Runs on pull requests to validate code quality and run tests</td>
                            <td>Triggers, validation steps, test commands</td>
                        </tr>
                        <tr>
                            <td>Preproduction deployment</td>
                            <td>Deploys to a staging environment for testing before production release</td>
                            <td>Triggers, deployment steps, server configuration</td>
                        </tr>
                        <tr>
                            <td>Production deployment</td>
                            <td>Deploys to the production environment when ready</td>
                            <td>Triggers, deployment steps, server configuration</td>
                        </tr>
                    </tbody>
                </table>

            </div>
        </div>

        <div class="section_container">

            <div class="section-title">
                <span class="section-title_text">Need more help?</span>
            </div>

            <div class="section_content justify-center">
            
                <p class="next-steps_text">
                    Continue exploring the documentation to better understand how SWAT works
                    and how it can fit into your development workflow.
                </p>

                <div class="next-steps_actions">

                    <a href="{{ path('app_documentation_ci_cd') }}" class="next-steps_button">
                        CI/CD Pipeline
                    </a>

                    <a href="{{ path('app_documentation_project_structure') }}" class="next-steps_button">
                        Project Structure
                    </a>

                </div>
            </div>
        </div>
    </section>

</main>

{% endblock %}